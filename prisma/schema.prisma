generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NavbarLink {
  id                String @id @default(cuid())
  name              String
  href              String
  iconClass         String
  iconFontSizeClass String?
  sortOrder         Int
}

model SocialMediaLink {
  id              String  @id @default(cuid())
  name            String
  href            String
  iconClass       String
  hoverColorClass String?
  sortOrder       Int
}

model SiteSettings {
  id           String  @id @default("singleton")
  contactEmail String?
}

model PageMetadata {
  id          String @id @default(cuid())
  pageKey     String @unique // "home" | "about" | "portfolio" | "skills" | "contact"
  title       String
  description String @db.Text
}

model SkillsServicesSection {
  id                   String @id @default("services_singleton")
  sectionClass         String?
  headingText          String?
  headingLevel         Int?
  headingClass         String?
  servicesWrapperClass String?
  entryAnimations      Json
  scrollAnimations     Json

  services Service[]
}

model Service {
  id                      String @id @default(cuid())
  skillsServicesSectionId String
  section                 SkillsServicesSection @relation(fields: [skillsServicesSectionId], references: [id], onDelete: Cascade)
  iconClass               String
  title                   String
  description             String @db.Text
  sortOrder               Int
}

model PortfolioSection {
  id                   String @id @default("portfolio_singleton")
  sectionClass         String?
  headingText          String?
  headingLevel         Int?
  headingClass         String?
  projectsWrapperClass String?
  perPage              Int    @default(6)
  entryAnimations      Json
  scrollAnimations     Json

  projects Project[]
}

model Project {
  id                 String @id @default(cuid())
  portfolioSectionId String
  section            PortfolioSection @relation(fields: [portfolioSectionId], references: [id], onDelete: Cascade)
  slug               String @unique
  title              String
  description        String @db.Text
  thumbnailUrl       String
  previewUrl         String?
  sortOrder          Int
}

model SkillsCategoriesSection {
  id               String @id @default("skills_categories_singleton")
  sectionClass     String?
  headingText      String?
  headingLevel     Int?
  headingClass     String?
  entryAnimations  Json
  scrollAnimations Json

  categories SkillCategory[]
}

model SkillCategory {
  id                        String @id @default(cuid())
  skillsCategoriesSectionId String
  section    SkillsCategoriesSection @relation(fields: [skillsCategoriesSectionId], references: [id], onDelete: Cascade)
  // Rendered as this element's literal DOM id - the section's
  // entryAnimations selectors (e.g. "#web-developer-category .category-item")
  // target it directly, so renaming this can break those without a
  // matching edit to the animation JSON.
  slug               String  @unique
  labelText          String
  labelClass         String?
  itemsWrapperClass  String?
  sortOrder          Int

  items SkillItem[]
}

model SkillItem {
  id              String @id @default(cuid())
  skillCategoryId String
  category        SkillCategory @relation(fields: [skillCategoryId], references: [id], onDelete: Cascade)
  name            String
  iconUrl         String
  sortOrder       Int
}
