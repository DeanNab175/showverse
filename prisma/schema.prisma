generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NavbarLink {
  id                String @id @default(cuid())
  name              String
  href              String
  iconClass         String
  iconFontSizeClass String?
  sortOrder         Int
}

model SocialMediaLink {
  id              String  @id @default(cuid())
  name            String
  href            String
  iconClass       String
  hoverColorClass String?
  sortOrder       Int
}

model SiteSettings {
  id           String  @id @default("singleton")
  contactEmail String?
}
