generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NavbarLink {
  id                String @id @default(cuid())
  name              String
  href              String
  iconClass         String
  iconFontSizeClass String?
  sortOrder         Int
}

model SocialMediaLink {
  id              String  @id @default(cuid())
  name            String
  href            String
  iconClass       String
  hoverColorClass String?
  sortOrder       Int
}

model SiteSettings {
  id           String  @id @default("singleton")
  contactEmail String?

  // Theme colour overrides. Null means "use the default from globals.css" -
  // nothing is injected, so the CSS fallback applies. Values are validated
  // against CSS_COLOR_PATTERN (src/lib/theme-settings.ts) before they ever
  // reach the injected <style> block.
  primaryColor      String?
  secondaryColor    String?
  surfaceLightColor String?
  pageDarkColor     String?
  surfaceDarkColor  String?
}

model PageMetadata {
  id          String @id @default(cuid())
  pageKey     String @unique // "home" | "about" | "portfolio" | "skills" | "contact"
  title       String
  description String @db.Text
}

model SkillsServicesSection {
  id                   String @id @default("services_singleton")
  sectionClass         String?
  headingText          String?
  headingLevel         Int?
  headingClass         String?
  servicesWrapperClass String?
  entryAnimations      Json
  scrollAnimations     Json

  services Service[]
}

model Service {
  id                      String @id @default(cuid())
  skillsServicesSectionId String
  section                 SkillsServicesSection @relation(fields: [skillsServicesSectionId], references: [id], onDelete: Cascade)
  iconClass               String
  title                   String
  description             String @db.Text
  sortOrder               Int
}

model PortfolioSection {
  id                   String @id @default("portfolio_singleton")
  sectionClass         String?
  headingText          String?
  headingLevel         Int?
  headingClass         String?
  projectsWrapperClass String?
  perPage              Int    @default(6)
  entryAnimations      Json
  scrollAnimations     Json

  projects Project[]
}

model Project {
  id                 String @id @default(cuid())
  portfolioSectionId String
  section            PortfolioSection @relation(fields: [portfolioSectionId], references: [id], onDelete: Cascade)
  slug               String @unique
  title              String
  description        String @db.Text
  thumbnailUrl       String
  previewUrl         String?
  sortOrder          Int
}

model SkillsCategoriesSection {
  id               String @id @default("skills_categories_singleton")
  sectionClass     String?
  headingText      String?
  headingLevel     Int?
  headingClass     String?
  entryAnimations  Json
  scrollAnimations Json

  categories SkillCategory[]
}

model SkillCategory {
  id                        String @id @default(cuid())
  skillsCategoriesSectionId String
  section    SkillsCategoriesSection @relation(fields: [skillsCategoriesSectionId], references: [id], onDelete: Cascade)
  // Rendered as this element's literal DOM id - the section's
  // entryAnimations selectors (e.g. "#web-developer-category .category-item")
  // target it directly, so renaming this can break those without a
  // matching edit to the animation JSON.
  slug               String  @unique
  labelText          String
  labelClass         String?
  itemsWrapperClass  String?
  sortOrder          Int

  items SkillItem[]
}

model SkillItem {
  id              String @id @default(cuid())
  skillCategoryId String
  category        SkillCategory @relation(fields: [skillCategoryId], references: [id], onDelete: Cascade)
  name            String
  iconUrl         String
  sortOrder       Int
}

// Shared by Home and (later) About - both have one hero image with an
// optional inline-SVG illustration alternative to a plain photo.
model SiteImage {
  id                String  @id @default(cuid())
  // Rendered as the wrapping element's literal DOM id - referenced
  // directly by entry-animation selectors (e.g. "#home-image"), same
  // caveat as SkillCategory.slug above.
  wrapperId         String?
  wrapperClass      String?
  isIllustration    Boolean @default(false)
  illustrationHtml  String? @db.Text
  illustrationClass String?
  path              String

  homeSection       HomeSection?
  aboutIntroSection AboutIntroSection?
}

model HomeSection {
  id                 String  @id @default("home_singleton")
  wrapperClass       String?
  sectionClass       String?
  // Rendered directly on the content <article> wrapper (distinct from the
  // two section-level class fields above, which the current component
  // doesn't actually apply anywhere).
  contentWrapperClass String?
  greetMessage       String
  name             String
  jobTitle         String  @db.Text // preserves embedded \n
  shortDescription String  @db.Text
  viewPageLinks    Json // ViewPageLinkType[] - {url, text}[]
  imageId          String? @unique
  image            SiteImage? @relation(fields: [imageId], references: [id])
  entryAnimations  Json
  scrollAnimations Json
}

model AboutIntroSection {
  id                  String  @id @default("about_intro_singleton")
  wrapperClass        String?
  sectionClass        String?
  // Rendered directly on the content <article> wrapper - see the same
  // field on HomeSection for why this is separate from the two
  // section-level class fields above.
  contentWrapperClass String?
  headingText         String?
  headingLevel        Int?
  headingClass        String?
  paragraphsBody      String[]
  paragraphsClass     String?
  experiencesWrapperClass String?
  hobbyHeadingText     String?
  hobbyHeadingLevel    Int?
  hobbyHeadingClass    String?
  ctaLabel             String?
  ctaVariant           String?
  ctaIconClass         String?
  ctaWrapperClass      String?
  imageId              String? @unique
  image                SiteImage? @relation(fields: [imageId], references: [id])
  entryAnimations      Json
  scrollAnimations     Json

  experiences Experience[]
  hobbies     Hobby[]
}

model Experience {
  id                  String @id @default(cuid())
  aboutIntroSectionId String
  aboutIntroSection   AboutIntroSection @relation(fields: [aboutIntroSectionId], references: [id], onDelete: Cascade)
  total               Int
  description         String
  sortOrder            Int
}

model Hobby {
  id                  String @id @default(cuid())
  aboutIntroSectionId String
  aboutIntroSection   AboutIntroSection @relation(fields: [aboutIntroSectionId], references: [id], onDelete: Cascade)
  label               String
  iconClass           String
  sortOrder           Int
}

model AboutHireBannerSection {
  id               String  @id @default("about_hire_banner_singleton")
  wrapperClass     String?
  sectionClass     String?
  contentWrapperClass String?
  headingText      String?
  headingLevel     Int?
  headingClass     String?
  paragraphsBody   String[]
  paragraphsClass  String?
  ctaLabel         String?
  ctaVariant       String?
  ctaWrapperClass  String?
  // The section-level class applied to the column wrapping the CTA button
  // in BannerSection (distinct from ctaWrapperClass above, which is the
  // inner content.cta.wrapperClass) - unset in the current data but the
  // component supports it, so it's kept editable.
  ctaColumnClass   String?
  entryAnimations  Json
  scrollAnimations Json
}
