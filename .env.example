# Postgres connection string (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (Auth.js) — generate with: npx auth secret
AUTH_SECRET=""

# Required in production mode (Auth.js validates the request Host header
# against a trusted list otherwise). Netlify's domain isn't known ahead of
# time, so this is needed there too, not just for local `next start` testing.
AUTH_TRUST_HOST="true"

# One-off admin user creation (prisma/create-admin.ts) — not read at runtime
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Netlify Blobs (used by the admin image upload feature, e.g. portfolio
# project thumbnails) — auto-injected by the Netlify platform in production
# and deploy previews. Locally, `next dev`/`next start` do NOT have this
# context; run `netlify link` then `netlify dev` instead to test uploads,
# or verify after deploying. Without it, uploads fail with a clear
# "MissingBlobsEnvironmentError" rather than crashing - everything else
# (viewing/editing existing content) works fine regardless.
