# Postgres connection string (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (Auth.js) — generate with: npx auth secret
AUTH_SECRET=""

# Required in production mode (Auth.js validates the request Host header
# against a trusted list otherwise). Netlify's domain isn't known ahead of
# time, so this is needed there too, not just for local `next start` testing.
AUTH_TRUST_HOST="true"

# One-off admin user creation (prisma/create-admin.ts) — not read at runtime
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Netlify Blobs — auto-injected by the Netlify platform in production/deploy
# previews; only needed locally if running outside `netlify dev`.
# NETLIFY_BLOBS_CONTEXT=""
